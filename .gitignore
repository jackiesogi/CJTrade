# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secret
.env
# Generated by scripts/gen_config.sh — holds API_KEY / SECRET_KEY / CA_PASSWORD
*.cjconf

# Runtime data: sqlite mirrors and the ArenaX price cache (hundreds of MB,
# plus -shm/-wal sidecars). Regenerated on demand, never worth versioning.
data/
*.db
*.db-shm
*.db-wal

# Logs
*.log
logs/

# JSON files
*.json

# Coverage output from the test hooks and CI
.coverage
.coverage.*
htmlcov/

# mkdocs build output
site/

# What poc/experiments/bin writes as it runs
poc/experiments/runs.csv
poc/experiments/runs/

# Claude Code: personal settings stay local; .claude/settings.json is shared
# (and has to be un-ignored past the *.json rule above)
.claude/settings.local.json
!.claude/settings.json
