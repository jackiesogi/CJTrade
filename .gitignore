# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secret
.env
# Generated by scripts/gen_config.sh — holds API_KEY / SECRET_KEY / CA_PASSWORD
*.cjconf

# Runtime data: sqlite mirrors and the ArenaX price cache (hundreds of MB,
# plus -shm/-wal sidecars). Regenerated on demand, never worth versioning.
data/
*.db
*.db-shm
*.db-wal

# Logs
*.log
logs/

# JSON files
*.json